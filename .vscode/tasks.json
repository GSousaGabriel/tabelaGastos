{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm: start",
            "type": "shell",
            "command": "pnpm start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Application bundle generation|Changes detected",
                    "endsPattern": "Local:|Application bundle generation complete|Watch mode enabled|Failed to compile"
                }
            }
        }
    ]
}
